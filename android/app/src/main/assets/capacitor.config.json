{
	"appId": "com.mobilidade66.app",
	"appName": "66 Mobilidade",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": true,
		"allowNavigation": [
			"*"
		]
	},
	"android": {
		"allowMixedContent": true,
		"backgroundColor": "#FFCC00"
	},
	"plugins": {
		"Geolocation": {
			"enableHighAccuracy": true
		},
		"LocalNotifications": {
			"smallIcon": "ic_launcher",
			"iconColor": "#FFD100"
		}
	}
}
